{
  "manifest_version": 3,
  "name": "Sofa",
  "version": "0.1.0",
  "description": "Agentic PR reviews at your comfort. Adds a Sofa tab to GitHub pull requests: file tree on the left, whole-file diffs on the right.",
  "host_permissions": [
    "*://github.com/*",
    "*://raw.githubusercontent.com/*",
    "*://galaxy.corp.thoughtspot.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*",
        "*://galaxy.corp.thoughtspot.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "dist/sofa.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
